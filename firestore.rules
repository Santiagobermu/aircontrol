rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla base: cualquier ruta no especificada requiere autenticación estricta
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Colecciones operativas necesarias para cargar el sistema y turnos
    // Lectura permitida para funcionamiento fluido del cuadrante;
    // Cualquier creación, modificación o eliminación EXIGE usuario autenticado.
    match /controllers/{controllerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /schedule/{dayId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /exceptions/{excId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /manual_alerts/{alertId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /trades/{tradeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /requests/{reqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /controller_notes/{ctrlId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Notificaciones leídas: estrictamente privadas por usuario autenticado
    match /user_notifications_read/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
