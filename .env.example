# =============================================================================
# AirControl SKBO - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' y completa con los valores reales correspondientes.
# =============================================================================

# Microsoft Power Automate Webhook (URL generada por el disparador HTTP con clave SAS)
VITE_POWER_AUTOMATE_WEBHOOK_URL=https://<environment>.api.powerplatform.com/powerautomate/automations/.../invoke?api-version=1&sp=...&sv=1.0&sig=...

# Configuración de Firebase Web
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=aircontrol-skbo-sbg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aircontrol-skbo-sbg
VITE_FIREBASE_STORAGE_BUCKET=aircontrol-skbo-sbg.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=588241571134
VITE_FIREBASE_APP_ID=1:588241571134:web:...
VITE_FIREBASE_MEASUREMENT_ID=G-...
