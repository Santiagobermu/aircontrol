rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Calendarios .ics: lectura pública requerida para suscripción externa (Google/Apple Calendar)
    // Escritura restringida estrictamente a usuarios autenticados
    match /calendars/{controllerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Firmas digitales: protegidas estrictamente para usuarios autenticados
    match /signatures/{signatureId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
